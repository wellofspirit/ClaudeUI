{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/web/**/*",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/core/**/*",
    "src/test/**/*",
    "src/e2e/**/*",
    "src/integration/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@test/*": [
        "./src/test/*"
      ]
    }
  }
}
