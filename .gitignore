# Engine binaries vendored before ADR-082 §8 (opencode, pi and Codex now install
# into ~/.claude/ui/harnesses); still ignored for older checkouts.
/vendor/opencode-cli/
/vendor/pi-cli/
/vendor/codex-cli/
# Engine source checkouts (vendor/<engine>-src/, at the tag of the engine's
# tested version) for reading upstream behavior — see CLAUDE.md.
/vendor/*-src/
