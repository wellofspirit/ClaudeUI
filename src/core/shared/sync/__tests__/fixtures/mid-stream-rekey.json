          "engineId": "claude",
          "account": null
        }
      ]
    },
    {
      "channel": "session:status",
      "args": [
        "uuid-9",
        {
          "state": "running",
          "sessionId": "uuid-9",
          "model": "sonnet",
          "cwd": "/repo",
          "totalCostUsd": 0.01,
          "engineId": "claude",
