{
  "name": "mid-stream rekey with duplicate client rekey invokes",
  "why": "A session spawns under a temporary routing id, streams, and only then learns its engine sessionId. Every client used to react to session:status by invoking session:rekey, so N clients fired N duplicate invokes; core owns the rekey now and the duplicates must converge on ONE application. The re-delivered status events below stand in for those duplicates.",
  "events": [
    { "channel": "session:created", "args": ["temp-1", { "cwd": "/repo" }] },
    {
      "channel": "session:item-open",
      "args": [
        "temp-1",
        {
          "target": { "messageId": "m1", "blockIndex": 0, "kind": "text" },
          "message": {
            "id": "m1",
            "role": "assistant",
            "content": [{ "type": "text", "text": "" }],
            "timestamp": 0
          }
        }
      ]
    },
    {
      "channel": "session:item-delta",
      "args": [
        "temp-1",
        { "target": { "messageId": "m1", "blockIndex": 0, "kind": "text" }, "chunk": "Sure, " }
      ]
    },
    {
      "channel": "session:status",
      "args": [
        "temp-1",
        {
          "state": "running",
          "sessionId": "uuid-9",
          "model": "sonnet",
          "cwd": "/repo",
          "totalCostUsd": 0.01,
          "engineId": "claude",
          "account": null
        }
      ]
    },
    {
      "channel": "session:status",
      "args": [
