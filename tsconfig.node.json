{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/core/**/*", "src/preload/**/*", "src/shared/**/*", "src/test/**/*", "src/integration/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@test/*": ["./src/test/*"]
    }
  }
}
