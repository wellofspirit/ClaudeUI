{
  "name": "claudui",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "Daniel Liu <wellofspirit@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wellofspirit/ClaudeUI",
  "claudeCliVersion": "2.1.231",
  "opencodeCliVersion": "1.18.10",
  "opencodeFork": {
    "repo": "https://github.com/wellofspirit/opencode.git",
    "branch": "claudeui",
    "tag": "v1.18.10"
  },
  "piCliVersion": "0.82.1",
  "ripgrepVersion": "14.1.1",
  "overrides": {
    "node-abi": "^4.33.0",
    "lightningcss": "^1.33.0",
    "@peculiar/asn1-schema": "2.9.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "node scripts/build.mjs build",
    "ensure-cli": "node scripts/build.mjs ensure-cli",
    "update-cli": "node scripts/build.mjs update-cli",
    "ensure-opencode": "node scripts/build.mjs ensure-opencode",
    "update-opencode": "node scripts/build.mjs update-opencode",
    "ensure-pi": "node scripts/build.mjs ensure-pi",
    "update-pi": "node scripts/build.mjs update-pi",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps && npm run ensure-cli && npm run ensure-opencode && npm run ensure-pi",
    "rebuild:native": "electron-builder install-app-deps",
    "build:unpack": "node scripts/build.mjs build:unpack",
    "build:win": "node scripts/build.mjs build:win",
    "build:mac": "node scripts/build.mjs build:mac",
    "build:linux": "node scripts/build.mjs build:linux",
    "build:web": "node scripts/build.mjs build:web",
    "test": "vitest run --project unit --project component --project e2e",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --project integration",
    "test:git": "vitest run --project git",
    "test:git:changed": "vitest run --project git --changed",
    "test:ci": "vitest run --project unit --project component --project e2e --project git",
    "test:patch": "node patch/test-all.mjs",
    "test:watch": "vitest --project unit"
  },
  "_comment_dependencies": "Only packages imported by src/main or src/preload belong here. electron-vite's externalizeDepsPlugin externalizes exactly the `dependencies` keys, so a main-process import that lives in devDependencies gets inline-bundled instead. Renderer/web-only packages are bundled by vite and must stay in devDependencies so electron-builder prunes them from the shipped node_modules.",
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mermaid-js/parser": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.8.1",
    "electron-context-menu": "^4.1.2",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "simple-git": "^3.36.0",
    "undici": "^6.28.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@swc/core": "^1.15.47",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "4.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi_up": "^6.0.6",
    "diff": "^9.0.0",
    "dompurify": "^3.4.13",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prism-react-renderer": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "4.1.10",
    "zustand": "^5.0.14"
  }
}
