{
  "name": "claudui",
  "version": "3.9.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "Daniel Liu <wellofspirit@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wellofspirit/ClaudeUI",
  "claudeCliVersion": "2.1.308",
  "ripgrepVersion": "14.1.1",
  "overrides": {
    "node-abi": "^4.39.0",
    "lightningcss": "^1.33.0",
    "@peculiar/asn1-schema": "2.9.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false --incremental --tsBuildInfoFile .cache/tsc/node.tsbuildinfo",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false --incremental --tsBuildInfoFile .cache/tsc/web.tsbuildinfo",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "node scripts/build.mjs build",
    "ensure": "node scripts/build.mjs ensure",
    "ensure-cli": "node scripts/build.mjs ensure-cli",
    "update-cli": "node scripts/build.mjs update-cli",
    "ensure-opencode": "node scripts/build.mjs ensure-opencode",
    "update-opencode": "node scripts/build.mjs update-opencode",
    "ensure-pi": "node scripts/build.mjs ensure-pi",
    "update-pi": "node scripts/build.mjs update-pi",
    "ensure-codex": "node scripts/build.mjs ensure-codex",
    "update-codex": "node scripts/build.mjs update-codex",
    "generate-codex-protocol": "bun scripts/generate-codex-protocol.mjs",
    "check-codex-protocol": "bun scripts/generate-codex-protocol.mjs --check",
    "generate-opencode-protocol": "bun scripts/generate-opencode-protocol.mjs",
    "check-opencode-protocol": "bun scripts/generate-opencode-protocol.mjs --check",
    "postinstall": "node scripts/build.mjs postinstall",
    "rebuild:native": "electron-builder install-app-deps",
    "build:unpack": "node scripts/build.mjs build:unpack",
    "build:win": "node scripts/build.mjs build:win",
    "build:mac": "node scripts/build.mjs build:mac",
    "build:linux": "node scripts/build.mjs build:linux",
    "test": "vitest run --project unit --project unit-node --project unit-forks --project component --project e2e --project browser",
    "test:unit": "vitest run --project unit --project unit-node --project unit-forks",
    "test:component": "vitest run --project component",
    "test:e2e": "vitest run --project e2e",
    "test:browser": "vitest run --project browser",
    "test:integration": "vitest run --project integration",
    "test:git": "vitest run --project git",
    "test:git:changed": "vitest run --project git --changed",
    "test:ci": "vitest run --project unit --project unit-node --project unit-forks --project component --project e2e --project browser --project git",
    "test:ci:no-browser": "vitest run --project unit --project unit-node --project unit-forks --project component --project e2e --project git",
    "test:patch": "node patch/test-all.mjs",
    "verify:sqlite": "bun scripts/verify-bun-sqlite.ts",
    "build:server": "node scripts/build-server.mjs bundle",
    "build:server:compile": "node scripts/build-server.mjs compile",
    "test:watch": "vitest --project unit --project unit-node --project unit-forks --project component"
  },
  "_comment_dependencies": "Only packages imported by src/main or src/preload belong here. electron-vite's main build.externalizeDeps externalizes the `dependencies` keys unless explicitly excluded, so a main-process import that lives in devDependencies gets inline-bundled instead. Renderer/web-only packages are bundled by vite and must stay in devDependencies so electron-builder prunes them from the shipped node_modules.",
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mermaid-js/parser": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@simplewebauthn/server": "^14.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.2",
    "electron-context-menu": "^5.1.0",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "simple-git": "^4.0.2",
    "undici": "^8.12.3",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint-react/eslint-plugin": "^5.28.5",
    "@fontsource/roboto": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@swc/core": "^1.16.18",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/ui": "5.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi_up": "^6.0.6",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "mermaid": "^12.2.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prism-react-renderer": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "zustand": "^5.0.16"
  }
}
